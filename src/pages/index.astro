---
import "../styles/global.css";
import App from "../components/App.jsx";

const siteOrigin = "https://thagore.io.vn";
const pageUrl = `${siteOrigin}/`;
const title = "Thagore - In-development native language and toolchain";
const description =
  "Thagore is an in-development programming language and toolchain focused on native builds, compiler-visible program structure, and honest release communication.";
const ogImage = `${siteOrigin}/thagore-logo.svg`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Thagore Foundation",
      url: siteOrigin,
      logo: ogImage
    },
    {
      "@type": "WebSite",
      name: "Thagore",
      url: pageUrl,
      inLanguage: "en",
      description
    },
    {
      "@type": "SoftwareApplication",
      name: "Thagore",
      applicationCategory: "DeveloperApplication",
      operatingSystem: "Windows, Linux, macOS",
      url: pageUrl,
      description
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Thagore, programming language, compiler, native toolchain, LLVM, WASM playground"
    />
    <meta
      name="robots"
      content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"
    />
    <link rel="canonical" href={pageUrl} />
    <link rel="sitemap" href={`${siteOrigin}/sitemap.xml`} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Thagore" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <App client:load />
    <noscript>
      <p>
        Thagore is an in-development programming language and toolchain focused on native builds,
        release discipline, and measurable compiler progress.
      </p>
    </noscript>
  </body>
</html>
